meta {
  name: Create category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Demo {{runId}}"
  }
}

script:post-response {
  bru.setEnvVar('categoryId', String(res.getBody().data.id));
}

tests {
test('Expected status 201', function () { expect(res.getStatus()).to.equal(201); });
}
